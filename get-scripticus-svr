#!/bin/sh
# get-scripticus-svr — stand up a Scripticus registry in one command (D61).
#
# Fetches the compose bundle, brings it up, and bootstraps Gitea with an admin
# account and a correctly-scoped publish token, printing both at the end. The
# alternative is a curl, a compose invocation, and a five-step trip through
# Gitea's web UI to find the right token scopes; this is that, without the
# guesswork.
#
#   curl -fsSL <raw-url> | sh                     # into ./scripticus-svr
#   curl -fsSL <raw-url> | sh -s -- --dir /srv/reg --user alice --port 9000
#   sh get-scripticus-svr                          # same, downloaded first
#
# POSIX sh on purpose: it is fetched and run on machines we know nothing about,
# and it must behave the same when piped to `sh`. That shapes two things: the
# only prompt reads from /dev/tty rather than stdin (which is the script), and
# secrets are generated and printed rather than asked for (D61).
#
# It refuses rather than repairs. An existing directory, stack, or Gitea user
# stops the run with an explanation, because the alternative is a script that
# half-owns somebody's registry and cannot tell you what state it left behind.
set -eu

# Everything below is one compound command, so `sh` must read to the closing
# brace before it runs any of it. That matters for the piped form: a shell
# reading a pipe executes as it goes, so a connection dropped mid-transfer
# would otherwise run a truncated script — far enough to start a stack,
# perhaps, but not far enough to bootstrap it. Unterminated, this is a syntax
# error and nothing happens at all. The body is left unindented on purpose;
# the brace is a delivery mechanism, not structure worth reading past.
{

RAW_BASE="https://raw.githubusercontent.com/kevinchannon/scripticus"
REF="${SCRIPTICUS_REF:-main}"
# Full override for the compose file's location — a fork, an internal mirror,
# an air-gapped copy, or a file:// URL when testing this script's own changes
# before they are pushed anywhere.
COMPOSE_URL="${SCRIPTICUS_COMPOSE_URL:-$RAW_BASE/$REF/docker-compose.yml}"

DIR="scripticus-svr"
DIR_GIVEN=""
USERNAME=""
ORG=""
ORG_GIVEN=""
EMAIL=""
PORT="8000"
PUBLIC_URL=""
TOKEN_NAME="scripticus-publish"
# What the index service actually calls: write:package for blob upload and
# download, read:user to resolve a token to a login, read:organization for the
# publish ACL check on an org namespace. The last is included even when no org
# exists yet, because without it `can_publish` gets a 403 it cannot distinguish
# from a refusal (gitea.py) — so a token minted before the first organisation
# would fail, later, with a permission error that names the wrong cause.
TOKEN_SCOPES="write:package,read:user,read:organization"
# Inline `configs` content in the compose file (D45) needs this or newer.
MIN_COMPOSE="2.23.1"

BOLD=''; RED=''; GREEN=''; YELLOW=''; NC=''
if [ -t 2 ]; then
    BOLD=$(printf '\033[1m'); RED=$(printf '\033[0;31m')
    GREEN=$(printf '\033[0;32m'); YELLOW=$(printf '\033[0;33m')
    NC=$(printf '\033[0m')
fi

# Progress goes to stderr; the credential summary at the end goes to stdout, so
# `get-scripticus-svr > creds.txt` captures the secrets and nothing else.
info() { printf '%s▶ %s%s\n' "$GREEN" "$*" "$NC" >&2; }
warn() { printf '%s! %s%s\n' "$YELLOW" "$*" "$NC" >&2; }
die() { printf '%s✗ %s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }

usage() {
    cat >&2 <<EOF
Usage: get-scripticus-svr [options]

  --dir <path>      where to put the stack (default: ./$DIR); skips the prompt
  --user <name>     the administrator's account, for running the registry
                    (default: your login name)
  --org <name>      the organisation packages are published under — the
                    namespace in <namespace>/<package>. Omit for no
                    organisation, publishing under the admin's own username
  --email <addr>    admin email (default: <user>@example.invalid)
  --port <n>        host port for the registry front (default: $PORT)
  --public-url <u>  the address browsers will use, if not http://localhost:<port>
                    (e.g. https://registry.example.com) — Gitea builds every
                    link and redirect from it
  --help            this message

Environment:
  SCRIPTICUS_REF          git ref to fetch the bundle from (default: main)
  SCRIPTICUS_COMPOSE_URL  full override for the compose file's URL, for a
                          fork, an internal mirror, or an air-gapped copy
EOF
    exit "${1:-0}"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dir) [ $# -ge 2 ] || die "--dir needs a value"; DIR="$2"; DIR_GIVEN=yes; shift 2 ;;
        --user) [ $# -ge 2 ] || die "--user needs a value"; USERNAME="$2"; shift 2 ;;
        --org) [ $# -ge 2 ] || die "--org needs a value"; ORG="$2"; ORG_GIVEN=yes; shift 2 ;;
        --email) [ $# -ge 2 ] || die "--email needs a value"; EMAIL="$2"; shift 2 ;;
        --port) [ $# -ge 2 ] || die "--port needs a value"; PORT="$2"; shift 2 ;;
        --public-url) [ $# -ge 2 ] || die "--public-url needs a value"; PUBLIC_URL="$2"; shift 2 ;;
        --help|-h) usage 0 ;;
        *) printf '%sunknown option: %s%s\n' "$RED" "$1" "$NC" >&2; usage 1 ;;
    esac
done

USER_GIVEN="$USERNAME"
[ -n "$USERNAME" ] || USERNAME=$(id -un)
# Gitea builds every link and redirect from ROOT_URL, so it has to be the
# address a browser will actually use — not the internal one.
[ -n "$PUBLIC_URL" ] || PUBLIC_URL="http://localhost:$PORT"
PUBLIC_URL=${PUBLIC_URL%/}
# Accounts, organisations, and tokens live in Gitea (D2/D4); the proxy serves
# its UI here so the bundle needs only the one port (D62).
UI_URL="$PUBLIC_URL/accounts/"

# Where the stack lives is the one choice worth confirming: it is the directory
# the operator will come back to for every `docker compose` from here on, and
# silently landing it in whatever the cwd happened to be is a poor surprise.
# Read from /dev/tty, not stdin, so this still works under `curl ... | sh`
# (where stdin is the script). No tty — CI, a pipe with no terminal — takes the
# default, so the script never blocks on a prompt it cannot show.
# The tty probe runs in a subshell on purpose. A redirection failure on a POSIX
# *special* built-in (`:` among them) exits the shell outright under dash, ash,
# and busybox sh — so probing inline would kill the script silently on exactly
# the machines that have no tty. A subshell absorbs that and just reports false.
HAVE_TTY=""
if [ -e /dev/tty ] && ( true >/dev/tty ) 2>/dev/null; then
    HAVE_TTY=yes
fi

if [ -z "$DIR_GIVEN" ] && [ -n "$HAVE_TTY" ]; then
    printf '%sWhere should the registry live?%s [%s] ' "$BOLD" "$NC" "$DIR" >/dev/tty
    read -r reply </dev/tty || reply=""
    [ -z "$reply" ] || DIR="$reply"
fi

# The login name is a reasonable guess at who is standing this up, and no more
# than a guess — the account is a real identity in the registry, so it is
# offered as a default rather than imposed.
if [ -z "$USER_GIVEN" ] && [ -n "$HAVE_TTY" ]; then
    printf '\n%sAdministrator account for this registry?%s [%s] ' "$BOLD" "$NC" "$USERNAME" >/dev/tty
    read -r reply </dev/tty || reply=""
    [ -z "$reply" ] || USERNAME="$reply"
fi

# Deferred until the name is settled, since it is derived from it.
[ -n "$EMAIL" ] || EMAIL="$USERNAME@example.invalid"

# The other choice worth asking about, and the one hardest to change later.
# Whoever administers the registry is rarely the identity packages should be
# published under: an admin account named after a person makes every package in
# the registry read `phil-from-it/backup-rotate`. The publishing namespace is an
# organisation, so it can be the company while the admin stays a person — and it
# is baked into every package reference from the first publish onwards.
if [ -z "$ORG_GIVEN" ] && [ -n "$HAVE_TTY" ]; then
    printf '\n%sPackages are published as <namespace>/<package>, and the namespace is\n' "$BOLD" >/dev/tty
    printf 'an organisation — usually your company or team, e.g. acme-co.%s\n' "$NC" >/dev/tty
    printf 'Leave blank to publish under your own username (%s) instead.\n' "$USERNAME" >/dev/tty
    printf '%sPublishing namespace?%s [none] ' "$BOLD" "$NC" >/dev/tty
    read -r reply </dev/tty || reply=""
    [ -z "$reply" ] || ORG="$reply"
fi

# Expand a leading ~ ourselves: it arrives literal from `read`, and a directory
# named '~' in the cwd is never what anyone meant.
case "$DIR" in
    "~") DIR="$HOME" ;;
    "~/"*) DIR="$HOME/${DIR#"~/"}" ;;
esac

# Compose derives its project name from the directory holding the compose file;
# doing the same means --dir gives a genuinely independent stack rather than one
# that collides with an existing install. Project names are [a-z0-9][a-z0-9_-]*,
# so lowercase, replace what is not allowed, and drop any leading remainder —
# a '.registry' becomes 'registry' rather than something with a prefix bolted
# on. printf, not echo, so no trailing newline reaches tr and becomes a '-'.
PROJECT=$(printf '%s' "$(basename "$DIR")" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9_-' '-' \
    | sed 's/^[^a-z0-9]*//')
# Only reachable if the name had no usable character in it at all.
[ -n "$PROJECT" ] || PROJECT="scripticus"

# --- preflight -------------------------------------------------------------
# Every check below fails the run before anything is created, so a machine that
# cannot host the stack is told so while the disk is still untouched.

info "checking prerequisites"

HAVE_CURL=""
if command -v curl >/dev/null 2>&1; then
    HAVE_CURL=yes
    fetch() { curl -fsSL "$1"; }
elif command -v wget >/dev/null 2>&1; then
    fetch() { wget -qO- "$1"; }
else
    die "need curl or wget to download the compose file"
fi

command -v docker >/dev/null 2>&1 \
    || die "docker is not installed — see https://docs.docker.com/get-docker/"
docker info >/dev/null 2>&1 \
    || die "the docker daemon is not reachable (is Docker running?)"

COMPOSE_VERSION=$(docker compose version --short 2>/dev/null) \
    || die "the docker compose v2 plugin is missing — 'docker compose version' failed"

# Numeric dotted compare, field by field. `sort -V` is not POSIX and is absent
# on enough systems to be worth avoiding in a bootstrap script.
version_ge() {
    _have="$1"; _want="$2"
    IFS=. read -r h1 h2 h3 <<EOF
${_have%%-*}
EOF
    IFS=. read -r w1 w2 w3 <<EOF
$_want
EOF
    h1=${h1:-0}; h2=${h2:-0}; h3=${h3:-0}
    w1=${w1:-0}; w2=${w2:-0}; w3=${w3:-0}
    [ "$h1" -gt "$w1" ] && return 0
    [ "$h1" -lt "$w1" ] && return 1
    [ "$h2" -gt "$w2" ] && return 0
    [ "$h2" -lt "$w2" ] && return 1
    [ "$h3" -ge "$w3" ]
}

CLEAN_VERSION=${COMPOSE_VERSION#v}
if ! version_ge "$CLEAN_VERSION" "$MIN_COMPOSE"; then
    die "docker compose $MIN_COMPOSE or newer is required (found $COMPOSE_VERSION).
   The bundle carries its proxy config inline, which older versions ignore."
fi
info "docker compose $COMPOSE_VERSION"

# --- refuse rather than repair ---------------------------------------------

if [ -e "$DIR" ] && [ -n "$(ls -A "$DIR" 2>/dev/null || true)" ]; then
    die "$DIR already exists and is not empty.
   Refusing to write into it. Remove it, or pass --dir somewhere else."
fi

if [ -n "$(docker compose -p "$PROJECT" ps -aq 2>/dev/null || true)" ]; then
    die "a '$PROJECT' compose stack already exists on this machine.
   Refusing to touch it. Inspect it with:
       docker compose -p $PROJECT ps
   and remove it with 'docker compose -p $PROJECT down -v' if it is disposable."
fi

# --- stand the bundle up ---------------------------------------------------

info "fetching docker-compose.yml ($REF)"
# Download somewhere disposable and only move it into place once it looks like
# a file worth keeping. A failed run then leaves nothing behind by construction,
# rather than by unwinding what it had already created — and an empty directory
# left by a failure is not cosmetic, it is what the *next* run refuses to use.
TMP=$(mktemp -d 2>/dev/null) || die "could not create a temporary directory"
trap 'rm -rf "$TMP"' EXIT HUP INT TERM

if ! fetch "$COMPOSE_URL" > "$TMP/docker-compose.yml"; then
    die "could not download the compose file from $COMPOSE_URL"
fi
[ -s "$TMP/docker-compose.yml" ] \
    || die "downloaded an empty compose file from $COMPOSE_URL — aborting"

mkdir -p "$DIR" || die "could not create $DIR"
mv "$TMP/docker-compose.yml" "$DIR/docker-compose.yml" \
    || die "could not write docker-compose.yml into $DIR"
cd "$DIR"

SCRIPTICUS_PORT="$PORT"
SCRIPTICUS_PUBLIC_URL="$PUBLIC_URL"
export SCRIPTICUS_PORT SCRIPTICUS_PUBLIC_URL

info "starting the stack (proxy + index + Gitea)"
if ! docker compose -p "$PROJECT" up -d; then
    die "the stack failed to start.
   If that was a port clash, re-run with --port on a free one."
fi

info "waiting for Gitea"
ready=""
i=0
while [ "$i" -lt 90 ]; do
    if fetch "$PUBLIC_URL/accounts/api/healthz" >/dev/null 2>&1; then
        ready=yes
        break
    fi
    sleep 2
    i=$((i + 1))
done
[ -n "$ready" ] || die "Gitea did not come up within 3 minutes.
   Check 'docker compose -p $PROJECT logs gitea'."

# --- bootstrap the admin account -------------------------------------------
# The Gitea CLI runs as the 'git' user; as root it refuses.
gitea_cli() { docker compose -p "$PROJECT" exec -T -u git gitea gitea "$@"; }

# APP_NAME titles every page, and the pages an operator sees should say what
# they came for. It sits in app.ini's unnamed root section, which Gitea's
# environment-to-ini mapping cannot reach — GITEA__DEFAULT__APP_NAME writes a
# [DEFAULT] section that Gitea then ignores — so it is edited in place on the
# generated config, once, here. Cosmetic by design: a failure is not worth
# stopping a working registry for, and standing the bundle up by hand instead
# of through this script simply leaves the stock title.
info "naming the instance"
docker compose -p "$PROJECT" exec -T gitea \
    sed -i 's/^APP_NAME =.*/APP_NAME = Scripticus/' /data/gitea/conf/app.ini \
    >/dev/null 2>&1 \
    && docker compose -p "$PROJECT" restart gitea >/dev/null 2>&1 \
    || warn "could not set the instance name; the UI will show Gitea's own"

# Gitea has just restarted, so wait for it again before using the CLI.
ready=""
i=0
while [ "$i" -lt 60 ]; do
    if fetch "$PUBLIC_URL/accounts/api/healthz" >/dev/null 2>&1; then
        ready=yes
        break
    fi
    sleep 2
    i=$((i + 1))
done
[ -n "$ready" ] || die "Gitea did not come back after being renamed.
   Check 'docker compose -p $PROJECT logs gitea'."

if gitea_cli admin user list 2>/dev/null | awk 'NR>1 {print $2}' | grep -qx "$USERNAME"; then
    die "Gitea already has a user '$USERNAME'.
   Refusing to touch an existing account. Its original token cannot be
   re-read (Gitea shows it once), so mint a new one in the web UI at
   $UI_URL — Settings > Applications, with the
   '$TOKEN_SCOPES' scopes."
fi

info "creating admin user '$USERNAME' and a publish token"
created=$(gitea_cli admin user create \
    --admin \
    --username "$USERNAME" \
    --email "$EMAIL" \
    --random-password \
    --must-change-password=false \
    --access-token \
    --access-token-name "$TOKEN_NAME" \
    --access-token-scopes "$TOKEN_SCOPES" 2>&1) \
    || die "creating the admin user failed:
$created"

# Parsed out of the CLI's human-readable output, which is the only place it
# exists — so an unrecognised format is a hard failure, never a blank secret.
PASSWORD=$(printf '%s\n' "$created" | sed -n "s/.*generated random password is '\(.*\)'.*/\1/p")
TOKEN=$(printf '%s\n' "$created" | sed -n 's/.*Access token was successfully created\.\.\. *//p')

if [ -z "$PASSWORD" ] || [ -z "$TOKEN" ]; then
    die "could not read the password and token back from Gitea. It said:
$created
   The account may exist. Check $UI_URL before re-running."
fi

# --- the publishing namespace ----------------------------------------------
# An organisation, created as the admin, who becomes its owner — so the admin
# can publish under it while the namespace itself carries no person's name.
# Gitea has no CLI for this, so it goes through the API as the user we just
# created, authenticated with the password rather than the token: creating an
# organisation would otherwise need write:organization on a long-lived
# publishing credential that has no other use for it.
NAMESPACE="$USERNAME"
if [ -n "$ORG" ]; then
    if [ -z "$HAVE_CURL" ]; then
        warn "no curl, so the '$ORG' organisation was not created — make it at
   $UI_URL and publish under it once it exists"
    else
        info "creating the '$ORG' organisation"
        org_status=$(curl -s -o /dev/null -w '%{http_code}' \
            -u "$USERNAME:$PASSWORD" \
            -X POST -H 'Content-Type: application/json' \
            -d "{\"username\":\"$ORG\",\"visibility\":\"public\"}" \
            "$PUBLIC_URL/accounts/api/v1/orgs" 2>/dev/null) || org_status="000"
        case "$org_status" in
            201) NAMESPACE="$ORG" ;;
            422) die "Gitea rejected the organisation name '$ORG'.
   It may already exist, clash with the '$USERNAME' account, or use characters
   Gitea does not allow. The registry is up; create the organisation at
   $UI_URL and publish under it." ;;
            *) die "could not create the '$ORG' organisation (HTTP $org_status).
   The registry is up and '$USERNAME' exists; create the organisation at
   $UI_URL and publish under it." ;;
        esac
    fi
fi

# Publishing under a person's account is fine for a personal registry and a
# trap for a shared one — every package reference carries that name for good.
# Say so once, here, rather than leaving it to be discovered at the tenth
# package.
NAMESPACE_NOTE=""
if [ "$NAMESPACE" = "$USERNAME" ]; then
    NAMESPACE_NOTE="
${YELLOW}That is your personal account. For a shared registry an organisation is
usually wanted instead, so packages read acme-co/<package> rather than one
person's name — make one at $UI_URL, or re-run with --org.${NC}"
fi

# --- the bit that matters --------------------------------------------------

cat <<EOF

${BOLD}${YELLOW}+---------------------------------------------------------------+
|  SAVE THESE NOW. THEY ARE SHOWN ONCE AND CANNOT BE RECOVERED. |
+---------------------------------------------------------------+${NC}

  ${BOLD}Registry URL${NC}   $PUBLIC_URL
  ${BOLD}Accounts${NC}       $UI_URL

  ${BOLD}Username${NC}       $USERNAME
  ${BOLD}Password${NC}       $PASSWORD
  ${BOLD}Token${NC}          $TOKEN

${YELLOW}The password can be reset from the accounts page, but the token cannot
be shown again — losing it means minting a replacement.${NC}

Put the token to work:

  pipx install scripticus
  scripticus login $PUBLIC_URL

You publish as ${BOLD}$NAMESPACE/<package>${NC}.$NAMESPACE_NOTE

Anyone else who publishes here registers their own account at
$UI_URL. Add them to $NAMESPACE from its People tab and they can
publish under it too; the '$USERNAME' account is yours alone.

Manage the stack from ${BOLD}$(pwd)${NC}:

  docker compose -p $PROJECT ps
  docker compose -p $PROJECT logs -f
  docker compose -p $PROJECT down          # stop, keep the data
  docker compose -p $PROJECT down -v       # stop and delete everything

EOF
}  # end of the read-it-all-before-running guard
